DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
# Optional: orchestrator mode with a pool of distinct jukebox bots (>=3 tokens)
# Example: JUKEBOX_TOKENS=token_bot_1,token_bot_2,token_bot_3
JUKEBOX_TOKENS=
# Optional fixed names (CSV) for jukebox aliases/nicknames in guild
JUKEBOX_FIXED_NAMES=

POSTGRES_URL=postgresql://quantum:quantum@postgres:5432/quantum_jukebox
REDIS_URL=redis://redis:6379

LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

LOG_LEVEL=info
DEFAULT_VOLUME=80
PLAYER_EMPTY_TIMEOUT_MS=300000
PLAYER_SELF_DEAF=true
# Supports unicode or custom animated emoji format: <a:name:id>
MUSIC_PANEL_EMOJI=??
MUSIC_CONTROL_CHANNEL_ID=
AUTOPLAY_DEFAULT=false
STAY_IN_VOICE_DEFAULT=false

# Comma separated role ids allowed to use DJ commands.
DJ_ROLE_IDS=
# Comma separated role ids allowed to manage the command center.
COMMAND_CENTER_ROLE_IDS=

# Optional for LavaSrc native Spotify resolving on Lavalink (not used directly by the bot)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional but recommended for youtube-plugin anti-bot resilience
YOUTUBE_REMOTE_CIPHER_URL=https://cipher.kikkia.dev/
YOUTUBE_REMOTE_CIPHER_USER_AGENT=quantum-jukebox
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INITIALIZATION=false


